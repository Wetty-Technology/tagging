root ::= ("<think>\n"
[^<]{0,1000}
"</think>\n"
"\n"
"```json\n"
(array "\n")
"```"
)
array ::= "[" items? "]"
items ::= item (", " item)*
item ::= "\"" tag "\""
tag ::= "性转" | "伪娘" | "百合" | "BL" | "娱乐" | "校园" | "古风" | "科幻" | "玄幻" | "皇宫" | "贞操带" | "拘束" | "项圈" | "淫纹" | "女仆" | "OL" | "魅魔" | "修女" | "魔法少女" | "警察"