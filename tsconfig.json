{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "lib": [
      "ESNext",
      "ESNext.String",
    ]
  }
}
